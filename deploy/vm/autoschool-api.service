[Unit]
Description=Autoschool API
After=network.target

[Service]
Type=simple
User=__DEPLOY_USER__
WorkingDirectory=__APP_ROOT__/server
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=JWT_SECRET=__JWT_SECRET__
Environment=DATA_DIR=__APP_ROOT__/server/data
ExecStart=/usr/bin/node src/index.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
